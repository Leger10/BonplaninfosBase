# ------------------------------------------------------------------
#  Variables d'environnement - exemple pour la PRODUCTION (Hostinger)
#  Copier ce fichier en .env sur le serveur et remplir les vraies valeurs.
#  Ne jamais committer le .env : il est deja ignore par .gitignore.
# ------------------------------------------------------------------

# --- Base de donnees MySQL (hPanel > Bases de donnees > MySQL) -------
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_BASE
# Conserver les memes noms de tables que le schema Prisma (188 tables).
DATABASE_URL="mysql://u123456789_bpi:mot_de_passe@srvXXX.mysql.hostinger.com:3306/u123456789_bpi"

# --- Serveur Node ----------------------------------------------------
# 8888 en local. En prod, mettre 3000 ou 8080 et faire pointer le reverse
# proxy Nginx du domaine vers ce port (jamais exposer le port Node aInternet).
PORT=3000
NODE_ENV=production

# --- Secrets ---------------------------------------------------------
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-remplacer-par-une-chaine-aleatoire-de-64-caracteres"

# --- URL publique (necessaire pour les liens de paiement et WhatsApp) --
VITE_SITE_URL="https://bonplaninfos.net"
DEPLOY_URL="https://bonplaninfos.net"
LOGIN_URL="https://bonplaninfos.net/login"

# --- Medias ----------------------------------------------------------
# Dossier des images uploadees. Doit etre HORS du dossier du projet si l'on
# veut survives a un redemarrage / redploiement, et doit etre writable.
MEDIA_ROOT=/home/u123456789/medias

# --- Notifications push (VAPID) --------------------------------------
VITE_VAPID_PUBLIC_KEY="BExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Supabase (uniquement si le mode local est desactive) -------------
# L'appli fonctionne en local sur Prisma : VITE_SUPABASE_URL n'est plus
# necessaire cote front, mais certaines functions le lisent encore.
VITE_SUPABASE_URL="http://127.0.0.1:3000"
VITE_SUPABASE_ANON_KEY="sb_publishable_placeholder"
VITE_SUPABASE_SERVICE_ROLE_KEY="placeholder"

# --- MoneyFusion (recharge de pieces par carte) ----------------------
# NON IMPLEMENTE en local : process_moneyfusion_success renvoie
# NOT_IMPLEMENTED. Ne pas activer en prod sans avoir corrige la fonction.
MONEYFUSION_API_URL="https://api.moneyfusion.com/api/v1/"
MONEYFUSION_API_KEY="remplacer_si_le_paiement_carte_est_active"

# --- USSD -------------------------------------------------------------
USSD_MERCHANT="BPI"
