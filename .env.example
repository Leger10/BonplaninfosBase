# ------------------------------------------------------------------
#  Variables d'environnement - exemple pour la PRODUCTION (Hostinger)
#  Copier ce fichier en .env sur le serveur et remplir les vraies valeurs.
#  Ne jamais committer le .env : il est deja ignore par .gitignore.
# ------------------------------------------------------------------

# --- Base de donnees MySQL (hPanel > Bases de donnees > MySQL) -------
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_BASE
# Conserver les memes noms de tables que le schema Prisma (188 tables).
DATABASE_URL="mysql://u123456789_bpi:mot_de_passe@srvXXX.mysql.hostinger.com:3306/u123456789_bpi"

# --- Serveur Node ----------------------------------------------------
# 8888 en local. En prod, mettre 3000 ou 8080 et faire pointer le reverse
# proxy Nginx du domaine vers ce port (jamais exposer le port Node aInternet).
PORT=3000
NODE_ENV=production

# --- Secrets ---------------------------------------------------------
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-remplacer-par-une-chaine-aleatoire-de-64-caracteres"

# Cle interne des RPC reserves au serveur. SANS elle, l'ajustement du stock des
# billets (adjust_ticket_stock) refuse tout appel et la validation des paiements
# USSD echoue. Les RPC restent authentifiees : toute autre RPC exige le jeton de
# session de l'utilisateur (ou cette cle interne, qui prime).
INTERNAL_RPC_KEY="a-remplacer-par-une-autre-chaine-aleatoire-de-64-caracteres"

# --- URL publique (necessaire pour les liens de paiement et WhatsApp) --
VITE_SITE_URL="https://bonplaninfos.net"
DEPLOY_URL="https://bonplaninfos.net"
LOGIN_URL="https://bonplaninfos.net/login"

# --- Medias ----------------------------------------------------------
# Dossier des images uploadees. Doit etre HORS du dossier du projet si l'on
# veut survives a un redemarrage / redploiement, et doit etre writable.
MEDIA_ROOT=/home/u123456789/medias

# --- Firebase Cloud Messaging : configuration client PUBLIQUE --------
# Ces valeurs sont visibles dans le navigateur (ce ne sont pas des secrets).
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="bonplaninfos-7e8f5.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bonplaninfos-7e8f5"
VITE_FIREBASE_STORAGE_BUCKET="bonplaninfos-7e8f5.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="503670420331"
VITE_FIREBASE_APP_ID="1:503670420331:web:..."
# Console Firebase > Parametres du projet > Cloud Messaging >
# Certificats Web Push : coller la cle publique VAPID ici.
VITE_FIREBASE_VAPID_KEY="B..."

# --- Firebase Admin : cle PRIVEE (ne jamais committer) ---------------
# Sans aucune configuration, le serveur cherche automatiquement :
#   firebase-service-account.json (racine du projet, private/, server/)
# Deposer donc ce fichier sur le serveur, dans le dossier contenant
# package.json (ignore par git). Attention : .env est versionne et ecrase
# a chaque deploiement, un chemin absolu pointant vers votre machine
# locale y proviendrait une erreur ENOENT en production.
# Alternative : chemin explicite, ou JSON brut/base64 dans
# FIREBASE_SERVICE_ACCOUNT_JSON (lisible par le process : preferer fichier).
# FIREBASE_SERVICE_ACCOUNT_PATH="/home/u123456789/private/firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- Notifications push : worker et cron ------------------------------
# Secret de la route POST /api/cron/push (en-tete x-cron-key).
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_CRON_SECRET="a-remplacer-par-une-chaine-aleatoire-de-64-caracteres"
PUSH_WORKER_ENABLED=true
PUSH_WORKER_INTERVAL_SECONDS=60
PUSH_WORKER_BATCH=25
# Decalage horaire du site (minutes a l'est de UTC). Cote d'Ivoire = 0.
PUSH_TIMEZONE_OFFSET_MINUTES=0
# Plafond de destinataires par diffusion (securite anti-emballement).
PUSH_MAX_RECIPIENTS=50000
PUSH_MAX_ATTEMPTS=5

# --- Supabase : retire du projet --------------------------------------
# Le projet Supabase n'est plus utilise : l'application tourne sur
# Prisma/MySQL via Express, et le client local (src/lib/localSupabaseClient.js)
# n'a besoin d'aucune URL ni cle Supabase. Les anciennes URL de medias
# ont ete reecrites en chemins relatifs /storage/v1/object/public/...

# --- MoneyFusion (recharge de pieces par carte) ----------------------
# NON IMPLEMENTE en local : process_moneyfusion_success renvoie
# NOT_IMPLEMENTED. Ne pas activer en prod sans avoir corrige la fonction.
MONEYFUSION_API_URL="https://api.moneyfusion.com/api/v1/"
MONEYFUSION_API_KEY="remplacer_si_le_paiement_carte_est_active"

# --- USSD -------------------------------------------------------------
USSD_MERCHANT="BPI"
